# Rahasia sesi Better Auth (minimal 32 karakter acak)
NUXT_BETTER_AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter-gurukampung
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (mendukung akun @guru.sd.belajar.id, PRD A-01)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Kunci API Gemini di sisi server saja, tidak pernah dikirim ke browser (aturan AI-01)
NUXT_GEMINI_API_KEY=

# Layanan Email Transaksional (Resend / Postmark / Brevo, PRD E-01)
NUXT_EMAIL_API_KEY=
NUXT_EMAIL_FROM=noreply@gurukampung.id

# Payment Gateway Indonesia (Xendit / Midtrans, PRD B-03 & B-04)
NUXT_PAYMENT_WEBHOOK_SECRET=

# Konfigurasi opsional NuxtStudio OAuth GitHub untuk produksi
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

